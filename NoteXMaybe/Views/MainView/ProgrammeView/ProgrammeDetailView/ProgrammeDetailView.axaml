<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NoteXMaybe.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NoteXMaybe.Views.ProgrammeDetailView"
             x:DataType="vm:ProgrammeDetailViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:ProgrammeDetailViewModel />
    </Design.DataContext>

    <!-- Programme Detail View Overlay -->

    <Panel>
        <Panel x:Name="ProgrammeOverlay" >

            <Grid RowDefinitions="Auto,*">

                <StackPanel  Grid.Row="0" Orientation="Vertical" Spacing="5" Margin="0,0,0,5">
                    <TextBox Text="{Binding ProgrammeLabel}" />
                    <TextBox Text="{Binding ProgrammeNotes}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="5">
                    
                    <TextBlock Text="Activities" />

                    <ListBox Grid.Row="1"
                        ItemsSource="{Binding ActivityItems}"
                        SelectedItem="{Binding SelectedActivityItem, Mode=TwoWay}" >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    CornerRadius="2"
                                    BorderThickness="2"
                                    BorderBrush="Black"
                                    Padding="5" >

                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" /> 
                                        <TextBlock Text="{Binding Notes}" />
                                    </StackPanel>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                
                </StackPanel>

            </Grid>
            
            <StackPanel Orientation="Vertical"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">

                <Button Content="-"
                    Command="{Binding ToggleCommandDropActivityMode}" />
                <Button Content="+"
                    Click="ToggleActivityInsertOverlay" />

            </StackPanel>

        </Panel>


        <!-- Activity Insert Overlay -->

        <Panel x:Name="ActivityInsertOverlay"
            IsVisible="False"
            Background="rgb(255, 255, 255)" >

            <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#00000000" >

                <!-- Status Space -->
                <TextBlock x:Name="InsertActivityStatus"
                    Text="{Binding InsertActivityStatusDetail}"
                    Foreground="rgb(255, 0, 0)"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <!-- Label Space -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Label"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <TextBox Text="{Binding ActivityLabelText}"
                        PlaceholderText="Title of the activity"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Notes Space -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Notes"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <TextBox Text="{Binding ActivityNotesText}"
                        PlaceholderText="Describe the activity"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding CommandSaveNewActivity}" />
                    <Button Content="Close" Click="CloseActivityInsertOverlay" />
                </StackPanel>

            </StackPanel>

        </Panel>
    </Panel>
    

</UserControl>
